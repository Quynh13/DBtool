# Copy to .env.frontend-debug (ignored by Git) and use a dedicated Target test DB.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
TOOL_DB_PATH=local-test/frontend-debug/db.sqlite3
TARGET_DB_HOST=replace-with-test-host
TARGET_DB_PORT=5432
TARGET_DB_NAME=replace-with-dedicated-test-db
TARGET_DB_USER=replace-with-test-user
TARGET_DB_PASSWORD=replace-with-test-password
